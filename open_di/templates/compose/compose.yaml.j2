# Generated by open-di — https://github.com/Nuxview/Open-DI
services:
{% for service in config.services %}
  {{ service.name }}:
    build:
      context: {{ service.build_context }}
{% if service.port %}
    ports:
      - "{{ service.port }}:{{ service.container_port if service.container_port else service.port }}"
{% endif %}
{% if service.depends_on %}
    depends_on:
{% for dep in service.depends_on %}
      - {{ dep }}
{% endfor %}
{% endif %}
{% if service.env_vars %}
    environment:
{% for key, value in service.env_vars.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if service.volumes %}
    volumes:
{% for vol in service.volumes %}
      - {{ vol }}
{% endfor %}
{% endif %}
{% if service.networks %}
    networks:
{% for net in service.networks %}
      - {{ net }}
{% endfor %}
{% endif %}
{% if not loop.last %}

{% endif %}
{% endfor %}
{% if config.networks %}

networks:
{% for network in config.networks %}
  {{ network }}:
{% endfor %}
{% endif %}
{% if config.volumes %}

volumes:
{% for vol in config.volumes %}
  {{ vol }}:
{% endfor %}
{% endif %}
