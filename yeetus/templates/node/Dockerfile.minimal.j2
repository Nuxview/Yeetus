{% if package_manager == 'bun' %}
FROM oven/bun:1-alpine

WORKDIR /app

COPY . .

RUN bun install
{% elif package_manager == 'pnpm' %}
FROM node:20-alpine

RUN npm install -g pnpm

WORKDIR /app

COPY . .

RUN pnpm install
{% elif package_manager == 'yarn' %}
FROM node:20-alpine

WORKDIR /app

COPY . .

RUN yarn install
{% else %}
FROM node:20-alpine

WORKDIR /app

COPY . .

RUN npm install
{% endif %}

EXPOSE {{ port }}

CMD {{ cmd }}
