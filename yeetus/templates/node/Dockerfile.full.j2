{% if package_manager == 'pnpm' %}
FROM node:20-alpine

RUN npm install -g pnpm@{{ package_manager_version or '9' }}
{% elif package_manager == 'bun' %}
FROM oven/bun:1-alpine

{% else %}
FROM node:20-alpine

{% endif %}

WORKDIR /app

{% if package_manager == 'bun' %}
COPY package.json bun.lock* bun.lockb* ./
{% elif package_manager == 'pnpm' %}
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* .pnpmfile.cjs* ./
{% elif package_manager == 'yarn' %}
COPY package.json yarn.lock* ./
{% else %}
COPY package*.json ./
{% endif %}
RUN {{ package_manager }} install

COPY . .

{% if framework == 'nextjs' %}
RUN {% if package_manager == 'bun' %}bun --bun run next build{% else %}./node_modules/.bin/next build{% endif %}

{% endif %}
ENV NODE_ENV=production

RUN chown -R {% if package_manager == 'bun' %}bun:bun{% else %}node:node{% endif %} /app
USER {% if package_manager == 'bun' %}bun{% else %}node{% endif %}


EXPOSE {{ port }}

{% if package_manager == 'bun' %}
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD bun -e "fetch('http://localhost:{{ port }}/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
{% else %}
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:{{ port }}/', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1));"
{% endif %}

CMD {{ cmd }}
