FROM python:3.12-slim

WORKDIR /app

{% if dependency_source == 'uv' %}
RUN pip install --no-cache-dir uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_PYTHON_DOWNLOADS=never
ENV PATH="/opt/venv/bin:$PATH"

{% endif %}
COPY . .

{% if dependency_source == 'requirements' %}
RUN pip install --no-cache-dir -r requirements.txt
{% elif dependency_source == 'uv' %}
RUN uv sync{% if uv_locked %} --locked{% endif %} --no-dev --no-editable
{% elif dependency_source == 'pipenv' %}
RUN pip install --no-cache-dir pipenv
RUN pipenv install --system{% if pipenv_locked %} --deploy --ignore-pipfile{% else %} --skip-lock{% endif %}
{% elif dependency_source == 'setup' %}
RUN pip install --no-cache-dir .
{% endif %}

EXPOSE {{ port }}

CMD {{ cmd }}
